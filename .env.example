# Public browser variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only variables — NEVER prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters
SESSION_SECRET=
# WeSend production API key. Keep server-only; never expose it to the browser.
WESEND_API_KEY=
# Admin passwords are stored as hashes in admin_credentials, not environment variables.
VAPID_PRIVATE_KEY=
PAYMENT_WEBHOOK_SECRET=

# Customer authentication:
# Phone number -> WeSend 6-digit OTP -> remembered HttpOnly device session.

# Optional video calling. Server only; generate a Cloudflare Realtime TURN key.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
